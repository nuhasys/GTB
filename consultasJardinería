USE jardineria;

--Ejer1
SELECT CodigoOficina, Ciudad FROM Oficinas; 
SELECT Count(*) AS numeroClientes FROM Empleados;
SELECT Pais, Count(*) AS numeroClientes FROM Clientes GROUP BY Pais;
SELECT AVG(Cantidad) FROM Pagos WHERE YEAR(FechaPago) = 2006;
SELECT Estado, Count(*) AS numeroPedidos FROM Pedidos GROUP BY Estado ORDER BY numeroPedidos DESC;
--Ejer 6
SELECT MIN(PrecioVenta), MAX(PrecioVenta) FROM Productos;
SELECT Ciudad, Telefono FROM Oficinas WHERE Pais LIKE "EEUU";
SELECT Nombre, Apellido1, Email FROM Empleados WHERE CodigoJefe = 3;
SELECT Puesto, Nombre, Apellido1, Email FROM Empleados WHERE CodigoJefe IS NULL;
SELECT Nombre, Apellido1, Puesto FROM Empleados WHERE Puesto IS NOT "Representante ventas";
--Ejer 11
SELECT COUNT(*) AS totalClientes FROM Clientes;
SELECT NombreCliente FROM Clientes WHERE Pais IN ("Espaa", "Spain");
SELECT Pais,COUNT(*) AS numeroClientes FROM Clientes GROUP BY Pais;
SELECT COUNT(*) AS clientesEnMadrid FROM Clientes WHERE Ciudad = "Madrid";
SELECT COUNT(*) AS cantidadClientes FROM Clientes WHERE Ciudad LIKE "M%";
--Ejer 16
SELECT CodigoEmpleadoRepVentas, Count(*) AS numeroClientes FROM Clientes GROUP BY CodigoEmpleadoRepVentas;
SELECT Count(*) AS clientesSinRepVent FROM Clientes WHERE CodigoEmpleadoRepVentas IS NULL;
SELECT MIN(FechaPago) AS primerPago, MAX(FechaPago) AS ultimoPago FROM Pagos;
SELECT CodigoCliente FROM Pagos WHERE YEAR(FechaPago) = 2008;
SELECT Estado FROM Pedidos GROUP BY Estado;
--Ejer 21
SELECT CodigoPedido,CodigoCliente,FechaEsperada,FechaEntrega FROM Pedidos WHERE FechaEntrega > FechaEsperada;
SELECT CodigoPedido, COUNT(CodigoProducto) FROM DetallePedidos GROUP BY CodigoPedido;
SELECT CodigoProducto, COUNT(*) AS vecesPedido FROM DetallePedidos GROUP BY CodigoProducto ORDER BY vecesPedido DESC LIMIT 20;
SELECT CodigoPedido, CodigoCliente, FechaEsperada, FechaEntrega FROM Pedidos WHERE FechaEntrega <= ADDDATE(FechaEsperada,INTERVAL -2 DAY);
SELECT SUM(Cantidad) * PrecioUnidad AS BaseImponible, ((SUM(Cantidad) * PrecioUnidad)/100)*18 AS IVA, SUM(Cantidad) * PrecioUnidad + ((SUM(Cantidad) * PrecioUnidad)/100)*18 AS Total FROM DetallePedidos GROUP BY PrecioUnidad;
SELECT CodigoProducto, SUM(Cantidad) * PrecioUnidad AS BaseImponible, ((SUM(Cantidad) * PrecioUnidad)/100)*18 AS IVA, SUM(Cantidad) * PrecioUnidad + ((SUM(Cantidad) * PrecioUnidad)/100)*18 AS Total FROM DetallePedidos WHERE CodigoProducto LIKE "FR%" GROUP BY CodigoProducto,PrecioUnidad;

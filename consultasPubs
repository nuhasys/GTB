CREATE DATABASE pubs;

USE pubs;

CREATE TABLE LOCALIDAD(COD_LOCALIDAD INTEGER CONSTRAINT pk_localidad PRIMARY KEY, NOMBRE VARCHAR(50) NOT NULL);

CREATE TABLE EMPLEADO(DNI_EMPLEADO VARCHAR(20) CONSTRAINT pk_empleado PRIMARY KEY, NOMBRE VARCHAR(50) NOT NULL, DOMICILIO VARCHAR());

CREATE TABLE PUB(COD_PUB VARCHAR(5) CONSTRAINT pk_pub PRIMARY KEY, NOMBRE VARCHAR(20) NOT NULL, LICENCIA_FISCAL VARCHAR(20) NOT NULL, DOMICILIO VARCHAR(), FECHA_APERTURA DATE() NOT NULL, HORARIO VARCHAR(4) NOT NULL CONSTRAINT horarios_enum CHECK(IN('HOR1','HOR2','HOR3')), COD_LOCALIDAD INTEGER NOT NULL CONSTRAINT fk_pub_localidad FOREIGN KEY(COD_LOCALIDAD)REFERENCES LOCALIDAD(COD_LOCALIDAD) );

CREATE TABLE EXISTENCIAS(COD_ARTICULO INTEGER NOT NULL CONSTRAINT pk_existencias PRIMARY KEY, NOMBRE VARCHAR(50)


